# Dockerfile.lint.base

FROM python:3.11-slim

# 1. Install git and clean up apt cache
RUN apt-get update \
 && apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/*

# 2. Upgrade pip and install linters + pre-commit
RUN pip install --upgrade pip \
 && pip install \
      black==23.9.1 \
      isort==5.12.0 \
      flake8==6.1.0 \
      pre-commit==3.4.0

# Working directory
WORKDIR /app

# By default, run pre-commit hooks on all files
ENTRYPOINT ["pre-commit", "run", "--all-files", "--show-diff-on-failure"]